# Copy to .env and fill in.  .env is gitignored.
NVR_HOST=192.168.2.199
NVR_RTSP_PORT=554
NVR_USER=nvruser
NVR_PASS=changeme

# Mosaic output rate/bitrate (keep modest for old TV hardware)
MOSAIC_FPS=12
MOSAIC_BITRATE=3500k

HLS_DIR=/opt/reolinktv/hls
HLS_PORT=8088

# Per-camera delay (seconds) to sync the mosaic tiles to the same moment.
# Hold the fast cameras back to match the slowest. Re-tune with mosaic/sync-tune.sh.
CAM_DELAY_1=0
CAM_DELAY_2=6
CAM_DELAY_3=9
CAM_DELAY_4=9
